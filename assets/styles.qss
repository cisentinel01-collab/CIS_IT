/* Professional Arabic WMS Theme - High Contrast & Pro Styling V2 */

QMainWindow {
    background-color: #f5f6fa;
}

QWidget {
    font-family: 'Cairo', 'Segoe UI', Tahoma;
}

/* Sidebar Navigation */
#Sidebar {
    background-color: #1a2a6c;
    min-width: 250px;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #ffffff;
    border: none;
    padding: 15px 20px;
    text-align: right;
    font-size: 14px;
    border-right: 5px solid transparent;
}

#Sidebar QPushButton:hover {
    background-color: #2a3a7c;
    color: #d4af37;
}

#Sidebar QPushButton:checked, #Sidebar QPushButton[active="true"] {
    background-color: #2a3a7c;
    border-right: 5px solid #d4af37;
    color: #d4af37;
    font-weight: bold;
}

/* Header Bar */
#Header {
    background-color: #ffffff;
    min-height: 65px;
    border-bottom: 2px solid #1a2a6c;
}

#Header QLabel {
    color: #1a2a6c;
    font-size: 18px;
    font-weight: bold;
}

/* Dashboard & Cards */
#Card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid #dcdde1;
}

#CardTitle {
    color: #7f8c8d;
    font-size: 14px;
    font-weight: bold;
}

#CardValue {
    font-size: 26px;
    font-weight: bold;
}

/* Buttons - PRO HIGH CONTRAST */
QPushButton {
    border-radius: 6px;
    padding: 12px 25px;
    font-weight: bold;
    font-size: 13px;
    border: none;
}

QPushButton#PrimaryButton {
    background-color: #1a2a6c;
    color: #ffffff;
    border-bottom: 3px solid #0d1a4d;
}

QPushButton#PrimaryButton:hover {
    background-color: #2a3a7c;
}

QPushButton#PrimaryButton:pressed {
    border-bottom: none;
    margin-top: 2px;
}

QPushButton#GoldButton {
    background-color: #d4af37;
    color: #1a2a6c;
    border-bottom: 3px solid #b8860b;
}

QPushButton#GoldButton:hover {
    background-color: #c5a028;
}

QPushButton#GoldButton:pressed {
    border-bottom: none;
    margin-top: 2px;
}

/* Default buttons should not be invisible */
QPushButton:!objectName {
    background-color: #ffffff;
    color: #1a2a6c;
    border: 2px solid #1a2a6c;
}

QPushButton:hover:!objectName {
    background-color: #f1f2f6;
}

/* Inputs - High Contrast & RTL Fixes */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #ffffff;
    border: 1px solid #1a2a6c;
    border-radius: 6px;
    padding: 10px;
    color: #1a2a6c;
    font-size: 15px;
    min-height: 20px;
}

QLineEdit:focus, QSpinBox:focus {
    border: 2px solid #d4af37;
}

/* SpinBox Padding Fix for RTL - prevents text overlap with arrows */
QSpinBox, QDoubleSpinBox {
    padding-left: 25px; /* Extra space for the value */
    padding-right: 5px;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #1a2a6c;
    border-radius: 6px;
    padding: 10px;
    color: #1a2a6c;
    font-size: 15px;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #f1f2f6;
    border: 1px solid #dcdde1;
    color: #1a2a6c;
    font-size: 14px;
}

QHeaderView::section {
    background-color: #1a2a6c;
    color: #ffffff;
    padding: 12px;
    font-weight: bold;
    border: none;
}

/* Progress Bars */
QProgressBar {
    border: 1px solid #dcdde1;
    border-radius: 8px;
    text-align: center;
    background-color: #f1f2f6;
    color: #1a2a6c;
    font-weight: bold;
    height: 15px;
}

QProgressBar::chunk {
    background-color: #1a2a6c;
    border-radius: 8px;
}

/* Financial Summary Panel */
#SummaryPanel {
    background-color: #ffffff;
    border: 3px solid #1a2a6c;
    border-radius: 12px;
    padding: 15px;
}

#TotalLabel {
    background-color: #1a2a6c;
    color: #d4af37;
    font-size: 24px;
    font-weight: bold;
    padding: 20px;
    border-radius: 8px;
}
