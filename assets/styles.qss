/* Professional Arabic WMS Theme */
/* Colors: Navy (#1a2a6c), Gold (#d4af37), White (#ffffff), Light Grey (#f5f6fa) */

QMainWindow {
    background-color: #f5f6fa;
}

QWidget {
    font-family: 'Cairo', 'Segoe UI', Tahoma;
}

/* Sidebar Navigation */
#Sidebar {
    background-color: #1a2a6c;
    min-width: 250px;
    max-width: 250px;
    border-left: 1px solid #1a2a6c;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #ffffff;
    border: none;
    padding: 15px 20px;
    text-align: right;
    font-size: 14px;
    border-right: 5px solid transparent;
}

#Sidebar QPushButton:hover {
    background-color: #2a3a7c;
    color: #d4af37;
}

#Sidebar QPushButton:checked, #Sidebar QPushButton[active="true"] {
    background-color: #2a3a7c;
    border-right: 5px solid #d4af37;
    color: #d4af37;
    font-weight: bold;
}

/* Header Bar */
#Header {
    background-color: #ffffff;
    min-height: 65px;
    border-bottom: 1px solid #dcdde1;
}

#Header QLabel {
    color: #1a2a6c;
    font-size: 18px;
    font-weight: bold;
}

/* Dashboard & Cards */
#Card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid #dcdde1;
}

#CardTitle {
    color: #7f8c8d;
    font-size: 14px;
    font-weight: bold;
}

#CardValue {
    color: #1a2a6c;
    font-size: 26px;
    font-weight: bold;
}

/* Buttons */
QPushButton#PrimaryButton {
    background-color: #1a2a6c;
    color: #ffffff;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    min-width: 100px;
}

QPushButton#PrimaryButton:hover {
    background-color: #2a3a7c;
}

QPushButton#GoldButton {
    background-color: #d4af37;
    color: #1a2a6c;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton#GoldButton:hover {
    background-color: #c5a028;
}

/* Inputs - High Contrast */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 10px;
    color: #1a2a6c;
    font-size: 14px;
}

QLineEdit:focus {
    border: 2px solid #1a2a6c;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 10px;
    color: #1a2a6c;
    font-size: 14px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a2a6c;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
    border: 1px solid #dcdde1;
    outline: none;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #f1f2f6;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    color: #1a2a6c;
}

QHeaderView::section {
    background-color: #1a2a6c;
    color: #ffffff;
    padding: 12px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #d4af37;
}

QTableWidget::item:selected {
    background-color: #f1f2f6;
    color: #1a2a6c;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #dcdde1;
    top: -1px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f1f2f6;
    color: #7f8c8d;
    padding: 12px 25px;
    border: 1px solid #dcdde1;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1a2a6c;
    font-weight: bold;
    border-top: 3px solid #1a2a6c;
}

/* Financial summary */
#SummaryPanel {
    background-color: #ffffff;
    border: 2px solid #1a2a6c;
    border-radius: 8px;
}

#TotalLabel {
    background-color: #1a2a6c;
    color: #d4af37;
    font-size: 22px;
    font-weight: bold;
    padding: 15px;
    border-radius: 4px;
}
