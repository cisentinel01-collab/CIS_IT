/* Premium Dark Navy & Gold Theme */

QMainWindow {
    background-color: #f5f6fa;
}

QWidget {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Sidebar */
#Sidebar {
    background-color: #1a2a6c;
    min-width: 250px;
    max-width: 250px;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #ecf0f1;
    border: none;
    padding: 15px;
    text-align: right;
    font-size: 15px;
    border-right: 5px solid transparent;
}

#Sidebar QPushButton:hover {
    background-color: #2a3a7c;
    color: #d4af37;
}

#Sidebar QPushButton[active="true"] {
    background-color: #2a3a7c;
    border-right: 5px solid #d4af37; /* Gold accent */
    color: #d4af37;
    font-weight: bold;
}

/* Header */
#Header {
    background-color: white;
    min-height: 60px;
    border-bottom: 1px solid #dcdde1;
}

#Header QLabel {
    color: #1a2a6c;
    font-size: 18px;
    font-weight: bold;
}

/* Cards */
#Card {
    background-color: white;
    border-radius: 10px;
    padding: 20px;
    border: 1px solid #dcdde1;
}

#CardTitle {
    color: #1a2a6c;
    font-size: 15px;
    font-weight: bold;
}

#CardValue {
    color: #1a2a6c;
    font-size: 24px;
    font-weight: bold;
}

/* Buttons */
QPushButton#PrimaryButton {
    background-color: #1a2a6c;
    color: white;
    border-radius: 5px;
    padding: 8px 15px;
    font-weight: bold;
}

QPushButton#PrimaryButton:hover {
    background-color: #2a3a7c;
}

QPushButton#SecondaryButton {
    background-color: white;
    color: #1a2a6c;
    border: 1px solid #1a2a6c;
    border-radius: 5px;
    padding: 8px 15px;
}

QPushButton#GoldButton {
    background-color: #d4af37;
    color: #1a2a6c;
    border-radius: 5px;
    padding: 8px 15px;
    font-weight: bold;
}

/* Inputs */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    border: 1px solid #dcdde1;
    border-radius: 8px;
    padding: 10px;
    padding-right: 35px; /* Comfortable space for arrows and Arabic text */
    padding-left: 10px;
    background-color: white;
    color: #1a2a6c;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
    font-size: 14px;
}

QComboBox {
    border: 1px solid #dcdde1;
    border-radius: 8px;
    padding: 10px;
    background-color: white;
    color: #1a2a6c;
    font-size: 14px;
}

QComboBox QAbstractItemView {
    background-color: white;
    color: #1a2a6c;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
    border: 1px solid #dcdde1;
    outline: none;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #dcdde1;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 25px;
    border-left: 1px solid #dcdde1;
}

QLineEdit:focus {
    border: 1px solid #1a2a6c;
}

/* Table */
QTableWidget {
    background-color: white;
    alternate-background-color: #f9f9f9;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
    color: #1a2a6c; /* Table text color */
    border: 1px solid #dcdde1;
}

QHeaderView::section {
    background-color: #1a2a6c;
    color: white;
    padding: 10px;
    border: 1px solid #2a3a7c;
}

/* Tabs Styling */
QTabWidget::pane {
    border: 1px solid #dcdde1;
    background: white;
}

QTabBar::tab {
    background: #f1f2f6;
    color: #1a2a6c;
    padding: 12px 30px;
    border: 1px solid #dcdde1;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: #1a2a6c;
    color: white;
}

#Sidebar QPushButton[active="true"] {
    background-color: #2a3a7c;
    border-right: 5px solid #d4af37;
}

QTabBar::tab:hover:!selected {
    background: #e1e2e6;
}

/* Financial Summary Labels */
#GoldSummaryLabel {
    color: #1a2a6c;
    font-size: 20px;
    font-weight: bold;
    padding: 15px;
    background-color: #d4af37;
    border-radius: 8px;
    border: 1px solid #b8860b;
}
