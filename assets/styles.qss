/* Professional Arabic WMS Theme - High Contrast & Pro Styling V3 */

QMainWindow {
    background-color: #f5f6fa;
}

QWidget {
    font-family: 'Cairo', 'Segoe UI', Tahoma;
    color: #1a2a6c; /* Default text color is Dark Navy for visibility */
}

/* Sidebar Navigation */
#Sidebar {
    background-color: #1a2a6c;
    min-width: 250px;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #ffffff;
    border: none;
    padding: 15px 20px;
    text-align: right;
    font-size: 14px;
    border-right: 5px solid transparent;
}

#Sidebar QPushButton:hover {
    background-color: #2a3a7c;
    color: #d4af37;
}

#Sidebar QPushButton:checked, #Sidebar QPushButton[active="true"] {
    background-color: #2a3a7c;
    border-right: 5px solid #d4af37;
    color: #d4af37;
    font-weight: bold;
}

/* Header Bar */
#Header {
    background-color: #ffffff;
    min-height: 65px;
    border-bottom: 3px solid #1a2a6c;
}

#Header QLabel {
    color: #1a2a6c;
    font-size: 18px;
    font-weight: bold;
}

/* Dashboard & Cards */
#Card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 20px;
    border: 2px solid #dcdde1; /* Thicker border */
}

#CardTitle {
    color: #2c3e50;
    font-size: 15px;
    font-weight: bold;
}

#CardValue {
    font-size: 28px;
    font-weight: bold;
    color: #1a2a6c;
}

/* Buttons - PRO HIGH CONTRAST */
QPushButton {
    border-radius: 6px;
    padding: 12px 25px;
    font-weight: bold;
    font-size: 13px;
    min-height: 20px;
}

QPushButton#PrimaryButton {
    background-color: #1a2a6c;
    color: #ffffff;
    border: 1px solid #1a2a6c;
}

QPushButton#GoldButton {
    background-color: #d4af37;
    color: #1a2a6c;
    border: 1px solid #b8860b;
}

/* Ensure default buttons are visible */
QPushButton:!objectName {
    background-color: #ffffff;
    color: #1a2a6c;
    border: 2px solid #1a2a6c;
}

/* Inputs - High Contrast */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #ffffff;
    border: 2px solid #1a2a6c; /* High contrast border */
    border-radius: 6px;
    padding: 10px;
    color: #000000 !important; /* Pure black text for maximum clarity */
    font-size: 15px;
    qproperty-alignment: 'AlignCenter'; /* Center text */
}

/* Fix spinbox text overlap in RTL */
QSpinBox, QDoubleSpinBox {
    padding-left: 35px;
    padding-right: 35px;
}

QComboBox {
    background-color: #ffffff;
    border: 2px solid #1a2a6c;
    border-radius: 6px;
    padding: 10px;
    color: #000000 !important;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
}

/* Tables - CRITICAL VISIBILITY */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #1a2a6c; /* Darker grid */
    border: 2px solid #dcdde1;
    color: #000000; /* Black text in tables */
    font-size: 14px;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
}

QHeaderView::section {
    background-color: #1a2a6c;
    color: #ffffff;
    padding: 12px;
    font-weight: bold;
    border: 1px solid #ffffff;
    font-size: 14px;
}

/* Tabs */
QTabWidget::pane {
    border: 2px solid #1a2a6c;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f1f2f6;
    color: #1a2a6c; /* High contrast text for tabs */
    padding: 15px 30px;
    border: 1px solid #dcdde1;
    font-weight: bold;
    font-size: 14px;
}

QTabBar::tab:selected {
    background-color: #1a2a6c;
    color: #ffffff;
}

/* Progress Bars */
QProgressBar {
    border: 2px solid #1a2a6c;
    border-radius: 8px;
    text-align: center;
    background-color: #f1f2f6;
    color: #000000;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #d4af37; /* Gold chunk on navy border */
}

/* Summary Labels */
#GoldSummaryLabel {
    background-color: #d4af37;
    color: #1a2a6c;
    font-size: 20px;
    font-weight: bold;
    padding: 20px;
    border: 2px solid #1a2a6c;
    border-radius: 10px;
}
