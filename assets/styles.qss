/* Premium Dark Navy & Gold Theme */

QMainWindow {
    background-color: #f5f6fa;
}

QWidget {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Sidebar */
#Sidebar {
    background-color: #1a2a6c;
    min-width: 250px;
    max-width: 250px;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: white;
    border: none;
    padding: 15px;
    text-align: right;
    font-size: 14px;
    border-right: 5px solid transparent;
}

#Sidebar QPushButton:hover {
    background-color: #2a3a7c;
}

#Sidebar QPushButton[active="true"] {
    background-color: #2a3a7c;
    border-right: 5px solid #d4af37; /* Gold accent */
}

/* Header */
#Header {
    background-color: white;
    min-height: 60px;
    border-bottom: 1px solid #dcdde1;
}

#Header QLabel {
    color: #1a2a6c;
    font-size: 18px;
    font-weight: bold;
}

/* Cards */
#Card {
    background-color: white;
    border-radius: 10px;
    padding: 20px;
    border: 1px solid #dcdde1;
}

#CardTitle {
    color: #7f8c8d;
    font-size: 14px;
}

#CardValue {
    color: #1a2a6c;
    font-size: 24px;
    font-weight: bold;
}

/* Buttons */
QPushButton#PrimaryButton {
    background-color: #1a2a6c;
    color: white;
    border-radius: 5px;
    padding: 8px 15px;
    font-weight: bold;
}

QPushButton#PrimaryButton:hover {
    background-color: #2a3a7c;
}

QPushButton#SecondaryButton {
    background-color: white;
    color: #1a2a6c;
    border: 1px solid #1a2a6c;
    border-radius: 5px;
    padding: 8px 15px;
}

QPushButton#GoldButton {
    background-color: #d4af37;
    color: #1a2a6c;
    border-radius: 5px;
    padding: 8px 15px;
    font-weight: bold;
}

/* Inputs */
QLineEdit, QComboBox, QTextEdit {
    border: 1px solid #dcdde1;
    border-radius: 5px;
    padding: 8px;
    background-color: white;
    color: #1a2a6c; /* Ensure text color is dark navy */
}

QLineEdit:focus {
    border: 1px solid #1a2a6c;
}

/* Table */
QTableWidget {
    background-color: white;
    alternate-background-color: #f9f9f9;
    selection-background-color: #d4af37;
    selection-color: #1a2a6c;
    border: none;
}

QHeaderView::section {
    background-color: #1a2a6c;
    color: white;
    padding: 10px;
    border: 1px solid #2a3a7c;
}
